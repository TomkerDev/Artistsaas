rules_version = '2';

// Règles de démarrage pour la collection `tracks` (nouveautés).
//
// Lecture : publique — l'application mobile lit les nouveautés sans compte.
// Écriture : réservée aux comptes authentifiés (le panneau d'administration).
//
// Durcissement recommandé une fois les custom claims en place :
//   allow write: if request.auth != null && request.auth.token.admin == true;
service cloud.firestore {
  match /databases/{database}/documents {
    match /tracks/{trackId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
