rules_version = '2';

// Règles de sécurité Firestore d'Artistsaas.
//
// Collections réelles de la base (vérifiées dans la console Firestore) :
//   `admin_users`  — comptes du panneau ; un document par admin, dont l'ID est
//                    l'UID Firebase Auth (contient `role`, `assignedArtistId`,
//                    `email`, …).
//   `events`       — billetterie / concerts          → lus par l'app mobile.
//   `merch`        — articles de la boutique         → lus par l'app mobile.
//   `tracks`       — catalogue musical               → lu par l'app mobile.
//   `tickets`      — billets réservés par le public  → lus/validés au panneau.
//   `billets`      — alias historique de `tickets` (non utilisé par le code).
//
// Modèle d'accès :
//   • lecture publique du contenu (l'app mobile tourne sans compte) ;
//   • écriture réservée à un **admin** = authentifié ET présent dans
//     `admin_users` (cf. `isAdmin()` plus bas) ;
//   • deux écritures publiques ciblées, indispensables au parcours d'achat
//     anonyme de l'app mobile : la création d'un billet `pending` et
//     l'incrément de `seats_sold` d'un événement (le public n'a pas de compte).
//
// L'importation de Jethsonat écrit des documents `tracks` portant `artistId ==
// 'jethsonat'` et `label == 'Tete Roh Studio'` : la validation ci-dessous
// refuse tout document dont le schéma dérive, afin qu'une coquille ou une
// saisie incomplète ne se retrouve pas dans l'application.
service cloud.firestore {
  match /databases/{database}/documents {
    match /tracks/{trackId} {

      // Lecture publique (application mobile, sans authentification).
      allow read: if true;

      // Écriture réservée aux comptes authentifiés.
      allow create: if isValidAdmin()
                    && isValidTrack();

      // Mise à jour : on ne réécrit pas un document existant avec un schéma
      // invalide. `request.resource` seul est contrôlé, ce qui autorise les
      // corrections partielles (suppression d'une pochette, par exemple).
      allow update: if isValidAdmin()
                    && isValidTrack();

      allow delete: if isValidAdmin();

      /// Le document respecte le schéma du catalogue.
      ///
      /// `audioUrl`/`audio_url` : URL absolue du MP3 (Supabase Storage).
      /// `imageUrl`/`cover_url` : facultatif, pochette.
      /// `duration_ms` : durée strictement positive.
      /// `label` : label partenaire crédité sur le lecteur.
      function isValidTrack() {
        let data = request.resource.data;
        let audio = 'audioUrl' in data ? data.audioUrl : data.audio_url;
        return data.keys().hasAll(['title', 'artist', 'artistId', 'duration_ms'])
            && 'label' in data
            && data.title is string
            && data.artist is string
            && data.artistId is string
            && data.label is string
            && data.duration_ms is int
            && data.duration_ms > 0
            && audio is string
            && audio.matches('^https?://.*');
      }
    }

    // ── Billetterie & shows ──────────────────────────────────────────────
    // Lecture publique : l'application mobile affiche les concerts à venir
    // sans compte. Création/suppression et édition complète : admin.
    // Une écriture publique ciblée est conservée : l'incrément de
    // `seats_sold` lors d'une réservation, car l'acheteur mobile n'a pas
    // encore de compte (cf. `store_repository.incrementSeatsSold`).
    match /events/{eventId} {
      allow read: if true;
      allow create: if isValidAdmin() && isValidEvent();
      allow delete: if isValidAdmin();
      allow update: if isValidAdmin() && isValidEvent();

      // Public (application mobile, sans compte) : seul `seats_sold` peut
      // changer, et uniquement par incrément — le reste du document reste
      // protégé. `diff().affectedKeys()` garantit qu'aucun autre champ n'est
      // touché.
      allow update: if request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['seats_sold']);
    }

    // ── Boutique merchandise ─────────────────────────────────────────────
    // Lecture publique : le catalogue produits est affiché sans compte.
    match /merch/{productId} {
      allow read: if true;
      allow create: if isValidAdmin() && isValidMerch();
      allow update: if isValidAdmin() && isValidMerch();
      allow delete: if isValidAdmin();
    }

    // ── Billets ──────────────────────────────────────────────────────────
    // Lecture et création : le public réserve et consulte ses billets. La
    // lecture publique corrige le `permission-denied` de l'onglet « Billets »
    // du panneau ; l'application mobile affiche aussi le QR du billet réservé.
    // L'identifiant de l'utilisateur est posé par le client ; ces règles
    // n'ont pas vocation à authentifier un scan d'entrée, qui relève d'un
    // contrôle au guichet par l'équipe. La mise à jour/suppression est, elle,
    // réservée à un admin (confirmation du paiement).
    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if request.resource.data.keys()
                       .hasAll(['event_id', 'ticket_type'])
                    && request.resource.data.status == 'pending';
      // Seul un admin fait évoluer un billet (confirmation du paiement) ou le
      // supprime : un client anonyme ne peut pas s'auto-confirmer, et un QR
      // code déjà émis ne peut pas être réécrit depuis le client.
      allow update, delete: if isValidAdmin();
    }

    // ── Billets (alias `billets`) ─────────────────────────────────────────
    // Collection `billets` : non utilisée par le code actuel. Règle identique
    // à `tickets` conservée par sécurité, au cas où un lot de données
    // l'emploierait.
    match /billets/{billetId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isValidAdmin();
    }

    // ── Comptes du panneau ───────────────────────────────────────────────
    // Lecture : son propre document (le panneau y lit son rôle et son
    // artiste) OU la liste complète pour un administrateur d'agence, qui gère
    // les accès depuis l'écran « Paramètres » du panneau.
    // Écriture : réservée à un administrateur d'agence. Un compte ne peut
    // jamais modifier son propre document (ni se promouvoir agency_admin) :
    // la garde `request.auth.uid != userId` l'interdit. L'attribution initiale
    // du premier agency_admin se fait depuis la console Firebase.
    // Note : `isAdmin()` / `isAgencyAdmin()` sondent cette collection via
    // `exists()` / `get()`, qui ne sont pas soumis à ces règles de lecture.
    match /admin_users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAgencyAdmin());
      allow create, update, delete: if isAgencyAdmin()
                                    && request.auth.uid != userId;
    }

    /// `true` si l'appelant est un administrateur d'agence (`agency_admin`).
    ///
    /// Sonde le rôle du compte appelant via `get()` (non soumis aux règles de
    /// lecture). Un compte sans document, ou dont le rôle n'est pas
    /// `agency_admin`, ne peut ni lister ni modifier les autres comptes.
    function isAgencyAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
          && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'agency_admin';
    }

    /// Compte autorisé à administrer la base.
    ///
    /// `true` si l'appelant est authentifié et qu'un document portant son UID
    /// existe dans `admin_users` (l'ID de document est l'UID Firebase Auth ;
    /// il contient `role`, `assignedArtistId`, `email`, …). L'appel `exists()`
    /// n'est pas soumis aux règles de lecture : il sonde la collection sans
    /// autorisation. La gestion des comptes se fait depuis la console Firebase.
    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    // Compte autorisé à publier (alias conservé pour la lisibilité des
    // règles ci-dessous) : exige désormais la présence dans `admin_users`.
    function isValidAdmin() {
      return isAdmin();
    }

    /// Événement conforme au schéma attendu par l'application mobile.
    ///
    /// `date` est un `timestamp` — et non une chaîne libre — pour pouvoir trier
    /// les concerts et n'afficher que les shows à venir. `date_label` conserve
    /// la formulation lisible choisie par l'organisateur.
    function isValidEvent() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'artistId', 'date', 'location'])
            && data.artistId is string
            && data.artistId.size() > 0
            && data.title is string
            && data.title.size() > 0
            && data.date is timestamp
            && data.location is string
            && data.price_std is number
            && data.price_vip is number
            && data.price_std > 0
            && data.price_vip > 0
            && data.mobile_money_number is string
            && data.mobile_money_number.size() > 0
            && data.total_seats is int
            && data.total_seats > 0;
    }

    /// Article de merchandising conforme au schéma attendu par l'application.
    ///
    /// `image_url` est facultative : l'application affiche une icône de
    /// repli. Lorsqu'elle est présente, elle doit être une URL absolue.
    function isValidMerch() {
      let data = request.resource.data;
      let hasImage = 'image_url' in data && data.image_url is string
                     && data.image_url.size() > 0;
      return data.keys().hasAll(['name', 'artistId', 'price_fcfa'])
            && data.artistId is string
            && data.artistId.size() > 0
            && data.name is string
            && data.name.size() > 0
            && data.price_fcfa is number
            && data.price_fcfa > 0
            && data.whatsapp_contact is string
            && data.whatsapp_contact.size() > 0
            && (hasImage == false
                || data.image_url.matches('^https?://.*'));
    }
  }
}
