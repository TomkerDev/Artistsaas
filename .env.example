# ─────────────────────────────────────────────────────────────
# Variables de configuration pour Novaa (Artistsaas)
# ─────────────────────────────────────────────────────────────
# Copiez ce fichier en `.env`, remplissez les valeurs, puis chargez-les
# dans votre environnement (ex. avec direnv, ou via le terminal) avant
# de lancer les configurations VS Code ci-dessous.
#
# Chaque variable est passée au build Flutter via `--dart-define`.
# Elles sont lues en compile-time par `String.fromEnvironment(...)`
# dans `lib/firebase_options.dart` et `lib/services/supabase_storage_service.dart`.
# ─────────────────────────────────────────────────────────────

# ── Firebase Core ──────────────────────────────────────────────
# Identifiants partagés entre toutes les plateformes.
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# ── Firebase App ID (par plateforme) ──────────────────────────
FIREBASE_APP_ID=              # Web
FIREBASE_ANDROID_APP_ID=      # Android (mobile)
FIREBASE_IOS_APP_ID=          # iOS
FIREBASE_MACOS_APP_ID=        # macOS

# ── Firebase Auth Domain (Web uniquement) ─────────────────────
FIREBASE_AUTH_DOMAIN=

# ── Firebase Bundle IDs (iOS / macOS uniquement) ─────────────
FIREBASE_IOS_BUNDLE_ID=
FIREBASE_MACOS_BUNDLE_ID=

# ── Supabase Storage ──────────────────────────────────────────
# Bucket public `artist-media` : MP3 et pochettes.
# Utilisé par le panneau d'administration (web) pour téléverser
# les médias, et par l'application mobile pour les lire en
# streaming (les URL publiques sont stockées dans Firestore).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Identité de l'application artiste (mobile) ─────────────────
# Valeurs utilisées par le script `scripts/build_apk.ps1`.
# `ARTIST_ID` doit correspondre au champ `artistId` des documents
# Firestore de l'artiste.
#
# Jethsonat (label Tete Roh Studio) :
ARTIST_ID=jethsonat
ARTIST_FOLDER=artist_2

# `false` = catalogue hybride : les titres embarqués dans
# `assets/catalog/catalog.json` (hors-ligne) sont jouables sans réseau, et
# les nouveautés Firestore s'y ajoutent par-dessus. C'est le mode de
# Jethsonat.
#
# `true` = « 100 % streaming » : le catalogue embarqué est ignoré, tout
# provient de Firestore. À n'utiliser que pour un artiste dont AUCUN titre
# n'est embarqué — sinon l'application s'affiche vide.
STREAM_ONLY=false
