# ─────────────────────────────────────────────────────────────
# Variables de configuration pour Novaa (Artistsaas)
# ─────────────────────────────────────────────────────────────
# Copiez ce fichier en `.env`, remplissez les valeurs, puis chargez-les
# dans votre environnement (ex. avec direnv, ou via le terminal) avant
# de lancer les configurations VS Code ci-dessous.
#
# Chaque variable est passée au build Flutter via `--dart-define`.
# Elles sont lues en compile-time par `String.fromEnvironment(...)`
# dans `lib/firebase_options.dart` et `lib/services/supabase_storage_service.dart`.
# ─────────────────────────────────────────────────────────────

# ── Firebase Core ──────────────────────────────────────────────
# Identifiants partagés entre toutes les plateformes.
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# ── Firebase App ID (par plateforme) ──────────────────────────
FIREBASE_APP_ID=              # Web
FIREBASE_ANDROID_APP_ID=      # Android (mobile)
FIREBASE_IOS_APP_ID=          # iOS
FIREBASE_MACOS_APP_ID=        # macOS

# ── Firebase Auth Domain (Web uniquement) ─────────────────────
FIREBASE_AUTH_DOMAIN=

# ── Firebase Bundle IDs (iOS / macOS uniquement) ─────────────
FIREBASE_IOS_BUNDLE_ID=
FIREBASE_MACOS_BUNDLE_ID=

# ── Supabase Storage ──────────────────────────────────────────
# Utilisé par le panneau d'administration (web) pour téléverser
# les médias dans le bucket public `artist-media`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
