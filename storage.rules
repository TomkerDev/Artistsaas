rules_version = '2';

// Règles de démarrage pour Cloud Storage (audio + pochettes des nouveautés).
//
// Lecture : publique — l'application mobile diffuse les MP3 via leurs URLs.
// Écriture : réservée aux comptes authentifiés (le panneau d'administration).
//
// Durcissement recommandé une fois les custom claims en place :
//   allow write: if request.auth != null && request.auth.token.admin == true;
service firebase.storage {
  match /b/{bucket}/o {
    match /artists/{artistId}/audio/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /artists/{artistId}/covers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
