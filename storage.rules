rules_version = '2';

// Cloud Storage for Firebase a été remplacé par Supabase Storage
// pour l'hébergement des médias (audio + pochettes d'albums).
//
// Supabase Storage gère les règles d'accès de manière indépendante
// via la console Supabase (bucket `artist-media`). Les URLs publiques
// sont générées par `SupabaseStorageService.getPublicUrl()` et consommées
// directement par l'application mobile.
//
// Toutes les règles Firebase Storage sont désactivées ici pour éviter
// tout accès non contrôlé au bucket Firebase.
service firebase.storage {
  match /b/{bucket}/o {
    allow read, write: if false;
  }
}
